<%= render 'base_form', {xhr: local_assigns.fetch(:xhr, nil),
                         form_action: local_assigns.fetch(:form_action, :batch_create),
                         method: local_assigns.fetch(:method, :post),
                         cancel_link: local_assigns.fetch(:cancel_link, true),
                         body_partial: batch_create_by_column ? 'batch_create_form_body' : 'batch_create_form_multiple',
                         footer_extension: ('batch_create_form_footer' unless batch_create_by_column),
                         scope: @scope,
                         headline: local_assigns.fetch(:headline, active_scaffold_config.batch_create.label)} %>

