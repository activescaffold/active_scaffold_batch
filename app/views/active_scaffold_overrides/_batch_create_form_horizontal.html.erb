<div class="form sub-form horizontal-sub-form">
<table cellpadding="0" cellspacing="0" id="<%= element_form_id action: form_action %>-content" class="multiple">
  <%
    header_locals = {
      columns: columns,
      scope: nil,
      record_class: records.values.first.class,
      crud_type: columns.action.crud_type,
      parent_record: nil,
      parent_column: nil
    }
  %>
  <%= render 'horizontal_subform_header', header_locals %>

  <% records.each.with_index do |(scope, record), index| %>
    <%
      record_locals = {
        columns: columns,
        form_action: form_action,
        scope: "[#{scope}]",
        first: index.zero?,
        record: record
      }
    %>
    <%= render 'batch_create_form_horizontal_record', record_locals %>
  <% end -%>
</table>
</div>
